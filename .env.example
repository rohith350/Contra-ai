# ==============================================================================
# Contra AI Backend Configuration Template
# Copy this file to .env and provide your credentials as needed.
# ==============================================================================

# Nebius Token Factory / NVIDIA Nemotron Settings
# Obtain an API key from Nebius Token Factory (OpenAI-compatible endpoint)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1
NEBIUS_MODEL_ID=nvidia/nemotron-4-340b-instruct

# Local Mock / Free-Demo Mode
# When ALLOW_MOCK_FALLBACK is true, the backend will gracefully use high-fidelity
# labelled mock data if NEBIUS_API_KEY is not configured, enabling zero-cost local dev.
ALLOW_MOCK_FALLBACK=true
MOCK_MODE=false

# Search Retrieval Configuration
# Real web search uses the free ddgs (DuckDuckGo) provider with zero paid API requirement.
MAX_SEARCH_QUERIES=5
MAX_RESULTS_PER_QUERY=4

# Quota and Application-Level Limits (Zero-Paid-Usage Safety)
MAX_MODEL_CALLS=10
MAX_OUTPUT_TOKENS=2048
INVESTIGATION_TIMEOUT_SECONDS=120

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATA_DIR=./data/investigations
